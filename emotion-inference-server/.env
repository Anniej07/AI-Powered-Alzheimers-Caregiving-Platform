# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS (your React dev server) ──────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ── Model backends ────────────────────────────────────────────
# Face: deepface backend — opencv | ssd | mtcnn | retinaface
FACE_DETECTOR_BACKEND=retinaface

# Face: emotion model — default uses DeepFace built-in
# (no change needed unless you swap to a custom model)

# Voice: HuggingFace model for speech emotion recognition
# Best open-source option for SER:
VOICE_MODEL=superb/wav2vec2-base-superb-er
# Lightweight fallback:
# VOICE_MODEL=superb/wav2vec2-base-superb-er

# ── Whisper (speech-to-text) ──────────────────────────────────
# tiny (~39MB) | base (~74MB) | small (~244MB) | medium (~769MB) | large (~1550MB)
WHISPER_MODEL=base

# ── Confidence thresholds ─────────────────────────────────────
MIN_FACE_CONFIDENCE=40.0
MIN_VOICE_CONFIDENCE=30.0

# ── Cache / model storage ─────────────────────────────────────
# DeepFace downloads models here on first run (~500 MB total)
DEEPFACE_HOME=./model_cache
